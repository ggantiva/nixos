// Input devices configuration.
// https://niri-wm.github.io/niri/Configuration:-Input
input {
  keyboard {
    xkb {
	  	layout "us";
	  	variant "altrgr-intl";
    }

  	repeat-rate 50;
  	repeat-delay 300;
  }

  mouse {
    accel-profile "flat"
  }

  warp-mouse-to-focus mode="center-xy-always"
  focus-follows-mouse max-scroll-amount="10%"
}
